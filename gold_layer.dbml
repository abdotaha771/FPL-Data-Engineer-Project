// FPL Gold Layer - Star Schema

Table dim_season {
  season_key int [pk]
  season_id varchar [not null]
  season_name varchar [not null]
}

Table dim_date {
  date_key int [pk]
  calendar_date date [not null]
  year int
  quarter int
  month int
  month_name varchar
  week_of_year int
  day_of_month int
  day_of_week int
  day_name varchar
  is_weekend boolean
}

Table dim_team {
  team_key int [pk]
  team_id int [not null]
  team_name varchar [not null]
  team_short_name varchar
  season_id varchar [not null]
  season_key int [not null]
}

Table dim_team_home {
  team_key int [pk]
  team_id int [not null]
  team_name varchar [not null]
  team_short_name varchar
  season_key int [not null]
}

Table dim_team_away {
  team_key int [pk]
  team_id int [not null]
  team_name varchar [not null]
  team_short_name varchar
  season_key int [not null]
}

Table dim_player {
  player_key int [pk]
  player_id int [not null]
  first_name varchar
  last_name varchar
  full_name varchar
  web_name varchar
  position varchar
  team_key int [not null]
  season_key int [not null]
}

Table fact_match {
  match_id varchar [pk]
  season_key int [not null]
  date_key int [not null]
  kickoff_time timestamp
  gameweek int
  finished boolean
  home_team_key int [not null]
  away_team_key int [not null]
  home_score int
  away_score int
  goal_difference int
  total_goals int
  match_result varchar
  home_possession int
  away_possession int
  home_expected_goals_xg float
  away_expected_goals_xg float
  home_total_shots int
  away_total_shots int
  home_shots_on_target int
  away_shots_on_target int
  home_corners int
  away_corners int
}

Table fact_team_match {
  team_match_key varchar [pk]
  match_id varchar [not null]
  season_key int [not null]
  date_key int [not null]
  kickoff_time timestamp
  gameweek int
  team_key int [not null]
  opponent_team_key int [not null]
  venue varchar [not null]
  team_goals int
  opponent_goals int
  goal_difference int
  team_possession int
  opponent_possession int
  team_expected_goals_xg float
  opponent_expected_goals_xg float
  team_total_shots int
  opponent_total_shots int
  team_shots_on_target int
  opponent_shots_on_target int
  team_corners int
  opponent_corners int
  finished boolean
  is_win boolean
  is_draw boolean
  is_loss boolean
  points int
}

Table fact_player_match {
  player_match_key varchar [pk]
  player_key int [not null]
  match_id varchar [not null]
  season_key int [not null]
  date_key int [not null]
  team_key int [not null]
  gameweek int
  kickoff_time timestamp
  minutes_played int
  goals int
  assists int
  goal_involvement int
  total_shots int
  xg float
  xa float
  xgot float
  shots_on_target int
  chances_created int
  touches int
  accurate_passes int
  tackles int
  interceptions int
  recoveries int
  blocks int
  clearances int
  saves int
  goals_conceded int
  offsides int
  start_min int
  finish_min int
  team_goals_conceded int
  penalties_scored int
  penalties_missed int
}

Ref: dim_player.team_key > dim_team.team_key
Ref: dim_team.season_key > dim_season.season_key
Ref: dim_team_home.season_key > dim_season.season_key
Ref: dim_team_away.season_key > dim_season.season_key
Ref: dim_player.season_key > dim_season.season_key

Ref: fact_match.season_key > dim_season.season_key
Ref: fact_match.date_key > dim_date.date_key
Ref: fact_match.home_team_key > dim_team_home.team_key
Ref: fact_match.away_team_key > dim_team_away.team_key

Ref: fact_team_match.season_key > dim_season.season_key
Ref: fact_team_match.date_key > dim_date.date_key
Ref: fact_team_match.team_key > dim_team.team_key
Ref: fact_team_match.opponent_team_key > dim_team.team_key

Ref: fact_player_match.season_key > dim_season.season_key
Ref: fact_player_match.date_key > dim_date.date_key
Ref: fact_player_match.player_key > dim_player.player_key
Ref: fact_player_match.team_key > dim_team.team_key
